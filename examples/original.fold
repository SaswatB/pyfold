fun active_names(users) = [user.name.strip() for user in users if user.active]

fun greet(name: str, excited: bool=false): str {
    var suffix = (if (excited) '!' else '.')
    return "Hello, ${name}${suffix}"
}

fun once(fetch, consume) {
    var value = fetch()
    return consume(value, value)
}

class Counter {
    fun __init__(self) {
        self.value = 0
    }
    fun increment(self) {
        self.value += 1
    }
}
